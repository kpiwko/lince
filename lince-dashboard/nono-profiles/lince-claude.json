{
  "extends": "claude-code",
  "meta": {
    "description": "LINCE sandbox profile for Claude Code",
    "name": "lince-claude"
  },
  "filesystem": {
    "allow": [
      "$WORKDIR"
    ],
    "read": [
      "$HOME/.local/lib"
    ]
  },
  "environment": {
    "allow_vars": [
      "TERM",
      "COLORTERM",
      "TERM_PROGRAM",
      "LANG",
      "LC_ALL",
      "EDITOR",
      "VISUAL",
      "ZELLIJ",
      "ZELLIJ_SESSION_NAME",
      "LINCE_AGENT_ID"
    ]
  },
  "security": {
    "signal_mode": "allow_same_sandbox"
  },
  "policy": {
    "add_deny_access": [
      "$XDG_CONFIG_HOME/nono/profiles"
    ]
  }
}
