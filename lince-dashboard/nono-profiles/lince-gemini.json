{
  "extends": "default",
  "meta": {
    "description": "LINCE sandbox profile for Google Gemini CLI",
    "name": "lince-gemini"
  },
  "filesystem": {
    "allow": [
      "$WORKDIR",
      "$HOME/.gemini"
    ],
    "read": [
      "$HOME/.local/lib"
    ]
  },
  "environment": {
    "allow_vars": [
      "TERM",
      "COLORTERM",
      "TERM_PROGRAM",
      "LANG",
      "LC_ALL",
      "EDITOR",
      "VISUAL",
      "ZELLIJ",
      "ZELLIJ_SESSION_NAME",
      "LINCE_AGENT_ID",
      "GEMINI_API_KEY"
    ]
  },
  "security": {
    "signal_mode": "allow_same_sandbox"
  }
}
