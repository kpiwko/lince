{
  "extends": "codex",
  "meta": {
    "description": "LINCE sandbox profile for OpenAI Codex",
    "name": "lince-codex"
  },
  "filesystem": {
    "allow": [
      "$WORKDIR",
      "$HOME/.codex"
    ],
    "read": [
      "$HOME/.local/lib"
    ]
  },
  "environment": {
    "allow_vars": [
      "TERM",
      "COLORTERM",
      "TERM_PROGRAM",
      "LANG",
      "LC_ALL",
      "EDITOR",
      "VISUAL",
      "ZELLIJ",
      "ZELLIJ_SESSION_NAME",
      "LINCE_AGENT_ID",
      "OPENAI_API_KEY"
    ]
  },
  "security": {
    "signal_mode": "allow_same_sandbox"
  }
}
